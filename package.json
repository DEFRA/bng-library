{
  "name": "bng-library",
  "version": "0.1.0",
  "description": "Shared BNG library: synthetic + workbook-driven GeoPackage generation, plus generic gpkg I/O helpers.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./gpkg-io": "./src/gpkg-io/index.mjs"
  },
  "files": [
    "index.mjs",
    "src/",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/bng-library.git"
  },
  "engines": {
    "node": ">=22.11"
  },
  "dependencies": {
    "wkx": "^0.5.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.0.0 || ^13.0.0",
    "xlsx": "^0.18.5"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{mjs,js,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{mjs,js,cjs,json,md}\"",
    "postinstall": "node scripts/postinstall.mjs",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "install:gitleaks": "node scripts/install-gitleaks.mjs"
  }
}
